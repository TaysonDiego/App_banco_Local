<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".AvaliacaoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Avaliações"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avalie os filmes cadastrados"
            android:textColor="#9E9E9E"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <!-- CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- FILME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filme"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:background="#2A2A2A"
                    android:padding="6dp">

                    <Spinner
                        android:id="@+id/spinnerFilme"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- USUÁRIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuário"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:background="#2A2A2A"
                    android:padding="6dp">

                    <Spinner
                        android:id="@+id/spinnerUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- NOTA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nota do filme"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="3"
                    android:layout_marginBottom="2dp"/>

                <!-- COMENTÁRIO -->

                <EditText
                    android:id="@+id/editComentario"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#2A2A2A"
                    android:gravity="top"
                    android:hint="Comentário"
                    android:textColorHint="#9E9E9E"
                    android:textColor="#FFFFFF"
                    android:padding="15dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp"/>

                <!-- BOTÃO -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarAvaliacao"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Salvar"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#E50914"
                    app:cornerRadius="18dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGerenciarAvaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:text="Gerenciar Avaliações"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#3949AB"
                    app:cornerRadius="18dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>


</ScrollView>